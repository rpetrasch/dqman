@prefix : <http://example.org/onto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://example.org/onto#> .

[ rdf:type owl:Ontology
 ] .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/onto#drives
:drives rdf:type owl:ObjectProperty ;
        rdfs:domain :Driver_Person ;
        rdfs:range :Vehicle .


#################################################################
#    Data properties
#################################################################

###  http://example.org/onto#hasAge
:hasAge rdf:type owl:DatatypeProperty ;
        rdfs:domain :Person ;
        rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  http://example.org/onto#Driver_Person
:Driver_Person rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Person
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :hasAge ;
                                                            owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                 owl:onDatatype xsd:integer ;
                                                                                 owl:withRestrictions ( [ xsd:minInclusive 18
                                                                                                        ]
                                                                                                      )
                                                                               ]
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:label "Driver (person operating a vehicle)"@en .


###  http://example.org/onto#Driver_Software
:Driver_Software rdf:type owl:Class ;
                 rdfs:label "Driver (software component)"@en .


###  http://example.org/onto#Person
:Person rdf:type owl:Class ;
        owl:disjointWith :Vehicle ;
        rdfs:label "Person"@en .


###  http://example.org/onto#Vehicle
:Vehicle rdf:type owl:Class ;
         rdfs:label "Vehicle"@en ;
         skos:altLabel "Automobile" ,
                       "Car" .


#################################################################
#    Individuals
#################################################################

###  http://example.invalid/ontologies/ont.owl#Maria
<http://example.invalid/ontologies/ont.owl#Maria> rdf:type owl:NamedIndividual ,
                                                           :Person ;
                                                  :hasAge 17 .


###  http://example.invalid/ontologies/ont.owl#Tom
<http://example.invalid/ontologies/ont.owl#Tom> rdf:type owl:NamedIndividual ,
                                                         :Person ;
                                                :hasAge 22 .


