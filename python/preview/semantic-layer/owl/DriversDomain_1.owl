@prefix : <http://example.org/onto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

### Concept
:Vehicle a owl:Class .
:Person  a owl:Class .

### Synonyms (same concept, alternate labels)
:Vehicle rdfs:label "Vehicle"@en ;
         skos:altLabel "Car", "Automobile" .

### Homonym (same term, distinct unrelated concepts — must NOT share a class)
:Driver_Person a owl:Class ;
    rdfs:label "Driver (person operating a vehicle)" .

:Driver_Software a owl:Class ;
    rdfs:label "Driver (software component controlling hardware)" .
# No owl:equivalentClass or shared superclass between these two —
# that's the point: identical term, zero semantic overlap.

### Relationship
:drives a owl:ObjectProperty ;
    rdfs:domain :Driver_Person ;
    rdfs:range :Vehicle .

### Constraint
:Vehicle owl:disjointWith :Person .

:Person a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :hasAge ;
        owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 18 ] ) ]
    ] . # only a Person with age ≥18 can be classified as :Driver_Person